              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('Somente reprovados, todos com motivo', () => {",
                  "  page.data.forEach(ad => {",
                  "    pm.expect(ad.status).to.equal('rejected');",
                  "    pm.expect(typeof ad.rejectionReason).to.equal('string');",
                  "    pm.expect(ad.rejectionReason.length).to.be.greaterThan(0);",
                  "  });",
                  "});",
                  "pm.test('Inclui o reprovado criado no fluxo', () => {",
                  "  const id = pm.collectionVariables.get('rejectedId');",
                  "  if (id) pm.expect(page.data.map(ad => ad.id)).to.include(id);",
                  "});",
                  "pm.test('Metadados coerentes', () => {",
                  "  pm.expect(page.page).to.equal(1);",
                  "  pm.expect(page.pageSize).to.equal(100);",
                  "  pm.expect(page.totalPages).to.equal(Math.ceil(page.total / 100));",
                  "});"
                ]
              }
            }
          ]
        },
